; Engine configuration file.
; Stunt Car VR - DE Test 1 "Drop & Dangle" (Godot 4.7, OpenXR, Quest-native target)

config_version=5

[application]

config/name="Stunt Car VR - DE Test 1"
config/description="DE feel-test 1 for Stunt Car VR: Drop Start under a drone, grab-wheel driving on an elevated ribbon, drone recovery lift with cockpit prep, lean-for-traction experiment. Not a game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[physics]

3d/run_on_separate_thread=false
common/physics_ticks_per_second=90

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.35, 0.55, 0.85, 1)

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
