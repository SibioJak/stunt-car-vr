; Engine configuration file.
; Stunt Car VR - LOOK TEST (throwaway spike, Godot 4.7, Forward+, OpenXR)
; Standalone project: the main game in ../game is NOT touched by this.
; Purpose: see the game's own car / ribbon / desert dressed with the
; full Forward+ renderer, to calibrate expectations before any look
; direction is committed for the real game.

config_version=5

[application]

config/name="Stunt Car VR - Look Test"
config/description="One dressed scene: the Odd Rod on a ribbon stretch over the desert at golden hour, Forward+ renderer. Not a game - no driving. C key / controller primary click toggles cockpit vs outside orbit view."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.35, 0.55, 0.85, 1)

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
